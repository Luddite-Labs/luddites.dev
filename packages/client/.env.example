# Canonical site origin (no trailing slash). Used for OG tags, canonical URLs, sitemap, robots.
VITE_SITE_URL=https://luddites.dev

# --- Contact form (pick one; first match wins) ---

# Recommended for a static site + personal Gmail (no backend):
# 1. Go to https://web3forms.com and create an access key with your Gmail
# 2. Paste the key below
# 3. In the Web3Forms dashboard, restrict the key to your domain
VITE_WEB3FORMS_ACCESS_KEY=

# Alternative: full provider URL (e.g. Formspree https://formspree.io/f/xxxx)
VITE_CONTACT_ENDPOINT=

# Alternative: your own API origin → POST ${VITE_API_BASE_URL}/contact
VITE_API_BASE_URL=
